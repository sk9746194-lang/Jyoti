## Local SDK configuration template for MYRA Android App
# In Android Studio, this file is automatically generated as local.properties.
# If compiling via command-line gradlew, copy this file to 'local.properties' and set your SDK path:
#
# Windows:
# sdk.dir=C\:\\Users\\YOUR_USER\\AppData\\Local\\Android\\Sdk
#
# macOS:
# sdk.dir=/Users/YOUR_USER/Library/Android/sdk
#
# Linux:
# sdk.dir=/home/YOUR_USER/Android/Sdk
