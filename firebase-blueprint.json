{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile authenticated with Google Account",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string" },
        "lastActiveAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "ConnectedDevice": {
      "title": "ConnectedDevice",
      "description": "Paired Android phone under authenticated user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "model": { "type": "string" },
        "androidVersion": { "type": "string" },
        "batteryLevel": { "type": "number" },
        "isCharging": { "type": "boolean" },
        "isOnline": { "type": "boolean" },
        "lastActive": { "type": "string" },
        "isPrimary": { "type": "boolean" },
        "pairingStatus": { "type": "string", "enum": ["paired", "pending", "revoked"] }
      },
      "required": ["id", "userId", "name"]
    },
    "DevicePermission": {
      "title": "DevicePermission",
      "description": "Granular user-approved remote permissions for companion phone",
      "type": "object",
      "properties": {
        "deviceId": { "type": "string" },
        "userId": { "type": "string" },
        "remoteAppLaunching": { "type": "boolean" },
        "deviceStatus": { "type": "boolean" },
        "sharedFiles": { "type": "boolean" },
        "mediaControl": { "type": "boolean" },
        "notifications": { "type": "boolean" },
        "hardwareControls": { "type": "boolean" },
        "accessibilityActions": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["deviceId", "userId"]
    },
    "PairingSession": {
      "title": "PairingSession",
      "description": "Expiring 6-digit or QR pairing request between primary and secondary device",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "code": { "type": "string" },
        "requesterDeviceId": { "type": "string" },
        "requesterDeviceName": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected", "expired"] },
        "expiresAt": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "code", "status"]
    },
    "RemoteActionCommand": {
      "title": "RemoteActionCommand",
      "description": "Approved remote command sent to companion phone",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "sourceDeviceId": { "type": "string" },
        "targetDeviceId": { "type": "string" },
        "action": { "type": "string" },
        "parameters": { "type": "string" },
        "status": { "type": "string", "enum": ["PENDING", "SUCCESS", "FAILED", "PERMISSION_REQUIRED", "DEVICE_OFFLINE", "NOT_SUPPORTED"] },
        "resultMessage": { "type": "string" },
        "createdAt": { "type": "string" },
        "executedAt": { "type": "string" }
      },
      "required": ["id", "userId", "targetDeviceId", "action", "status"]
    },
    "AuditLogEntry": {
      "title": "AuditLogEntry",
      "description": "Security audit log for remote actions and permission changes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "deviceId": { "type": "string" },
        "action": { "type": "string" },
        "details": { "type": "string" },
        "status": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "userId", "action", "timestamp"]
    },
    "DropTransfer": {
      "title": "DropTransfer",
      "description": "Cross-device secure file transfer request between paired phones",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "senderDeviceId": { "type": "string" },
        "receiverDeviceId": { "type": "string" },
        "fileName": { "type": "string" },
        "fileSize": { "type": "string" },
        "fileCategory": { "type": "string" },
        "status": { "type": "string", "enum": ["PENDING_APPROVAL", "TRANSFERRING", "COMPLETED", "DECLINED", "FAILED"] },
        "progress": { "type": "number" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "userId", "senderDeviceId", "receiverDeviceId", "fileName", "status"]
    },
    "TaskHandoff": {
      "title": "TaskHandoff",
      "description": "Futuristic AI cross-device task context handoff",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "sourceDeviceId": { "type": "string" },
        "targetDeviceId": { "type": "string" },
        "taskTitle": { "type": "string" },
        "taskType": { "type": "string" },
        "payload": { "type": "string" },
        "status": { "type": "string", "enum": ["READY", "RECEIVED", "OPENED"] },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "userId", "targetDeviceId", "taskTitle", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Root user profile document"
    },
    "/users/{userId}/devices/{deviceId}": {
      "schema": "ConnectedDevice",
      "description": "Registered devices for the user"
    },
    "/users/{userId}/permissions/{deviceId}": {
      "schema": "DevicePermission",
      "description": "Granular permissions for a device"
    },
    "/users/{userId}/pairingSessions/{sessionId}": {
      "schema": "PairingSession",
      "description": "Active pairing codes"
    },
    "/users/{userId}/commands/{commandId}": {
      "schema": "RemoteActionCommand",
      "description": "Remote commands queued or completed"
    },
    "/users/{userId}/auditLogs/{logId}": {
      "schema": "AuditLogEntry",
      "description": "Security audit records"
    },
    "/users/{userId}/dropTransfers/{transferId}": {
      "schema": "DropTransfer",
      "description": "Cross-device file transfer events"
    },
    "/users/{userId}/taskHandoffs/{handoffId}": {
      "schema": "TaskHandoff",
      "description": "Cross-device task handoff records"
    }
  }
}
